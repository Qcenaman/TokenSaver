<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 counterpart of data_extraction_rules.xml: nothing is backed up, matching allowBackup="false". -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
